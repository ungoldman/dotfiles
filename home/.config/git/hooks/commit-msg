#!/bin/sh
# rejects Claude attribution, then chains to the repo's own hook

if grep -qiE '^co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|^claude-session:|generated with \[claude code\]' "$1" ||
  git var GIT_AUTHOR_IDENT | grep -qiE 'claude|anthropic'; then
  echo "commit-msg: Claude attribution in message or author, commit rejected" >&2
  exit 1
fi

hook="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -x "$hook" ] && exec "$hook" "$@"
exit 0
